<Window x:Class="DumyWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DUMY - Знайомство" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F3EF">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" 
                CornerRadius="20" 
                Padding="40,35" 
                Width="580">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.06"/>
            </Border.Effect>

            <StackPanel>
                <!-- 1. ЛОГОТИП ТА ШАПКА -->
                <TextBlock Text="DUMY" 
                           FontFamily="Georgia" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Foreground="#1E1E1E"/>

                <Border Background="#F2EFE9" 
                        CornerRadius="12" 
                        Padding="12,4" 
                        HorizontalAlignment="Center" 
                        Margin="0,10,0,25">
                    <TextBlock Text="• Крок 1 з 2: Знайомство" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="#666053"/>
                </Border>

                <Separator Background="#EAE7E1" Margin="0,0,0,25"/>

                <!-- 2. ВВЕДЕННЯ ІМЕНІ -->
                <TextBlock Text="Як до вас звертатися? (Введіть ім'я)" 
                           FontWeight="Bold" 
                           FontSize="13" 
                           Foreground="#2D2D2D" 
                           Margin="0,0,0,8"/>

                <Border BorderBrush="#D1CDA5" BorderThickness="1" CornerRadius="10" Background="White" Padding="10,8" Margin="0,0,0,25">
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" 
                             BorderThickness="0" 
                             Background="Transparent" 
                             FontSize="14" 
                             VerticalAlignment="Center"/>
                </Border>

                <!-- 3. ВИБІР РЕЖИМУ РОБОТИ -->
                <TextBlock Text="Оберіть ваш основний режим роботи:" 
                           FontWeight="Bold" 
                           FontSize="13" 
                           Foreground="#2D2D2D" 
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Картка 1: Щоденний баланс -->
                    <Border Grid.Column="0" BorderBrush="#2D2D2D" BorderThickness="1.5" CornerRadius="10" Background="#FBFBF9" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="🩵" FontSize="16"/>
                                <RadioButton GroupName="ModeGroup" IsChecked="{Binding IsDailyBalanceMode, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Щоденний баланс" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Підтримка загальної гармонії та усвідомленості день за днем." FontSize="10" Foreground="#78746D" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Картка 2: Відновлення та фокус -->
                    <Border Grid.Column="2" BorderBrush="#E5E2DC" BorderThickness="1" CornerRadius="10" Background="White" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="⚙️" FontSize="16"/>
                                <RadioButton GroupName="ModeGroup" IsChecked="{Binding IsFocusMode, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Відновлення та фокус" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Зниження стресу, покращення сну та продуктивності." FontSize="10" Foreground="#78746D" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Картка 3: Тактичний -->
                    <Border Grid.Column="4" BorderBrush="#E5E2DC" BorderThickness="1" CornerRadius="10" Background="White" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="🛡️" FontSize="16"/>
                                <RadioButton GroupName="ModeGroup" IsChecked="{Binding IsTacticalMode, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Тактичний" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Швидка самодопомога у моменти тривоги чи гострого стресу." FontSize="10" Foreground="#78746D" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. КНОПКА "РОЗПОЧАТИ РОБОТУ" -->
                <Button Content="Розпочати роботу  ➔" 
                        Command="{Binding StartCommand}"
                        Height="45" 
                        Background="#8C95A3" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        FontSize="14" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Margin="0,0,0,20">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- 5. ФУТЕР -->
                <TextBlock Text="Dumy v1.0 (MVP) піклується про вашу конфіденційність. Усі введені дані зберігаються локально." 
                           FontSize="10" 
                           Foreground="#9E9A90" 
                           HorizontalAlignment="Center" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>