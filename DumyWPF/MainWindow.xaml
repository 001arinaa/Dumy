<Window x:Class="DumyWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:DumyWPF.ViewModels"
        xmlns:views="clr-namespace:DumyWPF.Views"
        mc:Ignorable="d"
        Title="DUMY" Height="720" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F5F2ED">

    <Window.Resources>
        <!-- Мапінг між ViewModel та відповідними Views -->
        <DataTemplate DataType="{x:Type viewmodels:OnboardingViewModel}">
            <views:OnboardingView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:DailyBalanceViewModel}">
            <views:DailyBalanceView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:FocusModeViewModel}">
            <views:FocusModeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TacticalModeViewModel}">
            <views:TacticalModeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <!-- Головний контейнер відображення екранів -->
    <ContentControl Content="{Binding CurrentViewModel}"/>

</Window>