<UserControl x:Class="DumyWPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Background="#F5F2ED">

    <UserControl.Resources>
        <!-- Кастомний стиль для ToggleButton (Перемикача) -->
        <Style TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" CornerRadius="12" Background="#C4C0B8">
                            <Ellipse x:Name="Dot" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#9AA3B6"/>
                                <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Dot" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="0">
        <!-- 1. ВЕРХНІЙ ХЕДЕР -->
        <Border DockPanel.Dock="Top" Background="White" Padding="30,12" BorderBrush="#EAE6DF" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DUMY" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="#25190E"/>
                    <TextBlock Text=" v1.0" FontFamily="Georgia" FontSize="18" Foreground="#C4C0B8"/>
                    <Border Background="#DAB6C8" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MVP" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Режим роботи:" VerticalAlignment="Center" Foreground="#C4C0B8" FontSize="12" Margin="0,0,8,0"/>
                    <Border Background="#FBF9F5" CornerRadius="12" Padding="12,6" Margin="0,0,10,0" BorderBrush="#EAE6DF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="• Налаштування" FontSize="12" FontWeight="SemiBold" Foreground="#25190E"/>
                            <TextBlock Text=" ∨" FontSize="10" Foreground="#C4C0B8" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#DAB6C8" CornerRadius="15" Width="30" Height="30">
                        <TextBlock Text="⚙" FontFamily="Segoe UI Emoji" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. НИЖНІЙ ФУТЕР -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,15" HorizontalAlignment="Center">
            <TextBlock Text="Dumy v1.0 (MVP) піклується про вашу конфіденційність. Усі введені дані зберігаються локально." 
                       FontSize="10" Foreground="#C4C0B8" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 3. ОСНОВНИЙ КОНТЕНТ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,25">

                <!-- ЗАГОЛОВОК СТОРІНКИ -->
                <TextBlock Text="НАЛАШТУВАННЯ ЗАСТОСУНКУ" FontWeight="Bold" FontSize="22" Foreground="#25190E" Margin="0,0,0,4"/>
                <TextBlock Text="Персоналізуйте ваш досвід роботи з Dumy та керуйте приватністю ваших даних" 
                           FontSize="12" Foreground="#C4C0B8" Margin="0,0,0,20"/>

                <!-- КАРТКА 1: ПРОФІЛЬ ТА РЕЖИМИ -->
                <Border Background="#FBF9F5" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="16" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="👤 " FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#25190E"/>
                            <TextBlock Text="ПРОФІЛЬ ТА РЕЖИМИ" FontWeight="Bold" FontSize="13" Foreground="#25190E"/>
                        </StackPanel>
                        <Border BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                        <TextBlock Text="РЕЖИМ ЗА ЗАМОВЧУВАННЯМ ПРИ ЗАПУСКУ:" FontSize="10" FontWeight="Bold" Foreground="#C4C0B8" Margin="0,0,0,12"/>

                        <!-- Варіант 1 -->
                        <RadioButton IsChecked="True" GroupName="DefaultMode" Margin="0,0,0,12">
                            <StackPanel Margin="6,-2,0,0">
                                <TextBlock Text="Щоденний баланс" FontWeight="Bold" FontSize="12" Foreground="#25190E"/>
                                <TextBlock Text="Регулярний моніторинг настрою, трекер звичок та щоденник думок для підтримки загального ментального тонусу." 
                                           FontSize="11" Foreground="#C4C0B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Варіант 2 -->
                        <RadioButton GroupName="DefaultMode" Margin="0,0,0,12">
                            <StackPanel Margin="6,-2,0,0">
                                <TextBlock Text="Фокус та Вигорання" FontWeight="Bold" FontSize="12" Foreground="#25190E"/>
                                <TextBlock Text="Спеціалізовані інструменти тайм-менеджменту та аналітики продуктивності для запобігання професійному вигоранню." 
                                           FontSize="11" Foreground="#C4C0B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Варіант 3 -->
                        <RadioButton GroupName="DefaultMode">
                            <StackPanel Margin="6,-2,0,0">
                                <TextBlock Text="Тактичний" FontWeight="Bold" FontSize="12" Foreground="#25190E"/>
                                <TextBlock Text="Швидкі SOS-практики заземлення, дихальні вправи та кризові сценарії стабілізації нервової системи." 
                                           FontSize="11" Foreground="#C4C0B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- КАРТКА 2: СПОВІЩЕННЯ ТА НАГАДУВАННЯ -->
                <Border Background="#FBF9F5" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="16" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔔 " FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#25190E"/>
                            <TextBlock Text="СПОВІЩЕННЯ ТА НАГАДУВАННЯ" FontWeight="Bold" FontSize="13" Foreground="#25190E"/>
                        </StackPanel>
                        <Border BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                        <!-- Нагадування 1 -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Нагадування про перерву для очей" FontWeight="Bold" FontSize="12" Foreground="#25190E"/>
                                <TextBlock Text="Регулярні підказки зробити коротку розминку кожні 45 хвилин активної сесії." FontSize="11" Foreground="#C4C0B8"/>
                            </StackPanel>
                            <ToggleButton IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Border BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                        <!-- Нагадування 2 -->
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Щоденний трекінг настрою" FontWeight="Bold" FontSize="12" Foreground="#25190E"/>
                                <TextBlock Text="М'яке ранкове нагадування зафіксувати свій стан о 9:00 ранку." FontSize="11" Foreground="#C4C0B8"/>
                            </StackPanel>
                            <ToggleButton IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- КАРТКА 3: КОНФІДЕНЦІЙНІСТЬ ТА ДАНІ -->
                <Border Background="#FBF9F5" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="16" Padding="24,20" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🛡 " FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#25190E"/>
                            <TextBlock Text="КОНФІДЕНЦІЙНІСТЬ ТА ДАНІ" FontWeight="Bold" FontSize="13" Foreground="#25190E"/>
                        </StackPanel>
                        <Border BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                        <!-- Плашка зі сповіщенням -->
                        <Border Background="#EAE6DF" CornerRadius="10" Padding="14,10" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔒 " FontFamily="Segoe UI Emoji" FontSize="12"/>
                                <TextBlock Text="Усі ваші дані зберігаються локально в шифрованій SQLite базі даних безпосередньо на цьому пристрої." 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#25190E"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Height="38" Background="White" BorderBrush="#C4C0B8" BorderThickness="1" Cursor="Hand"
                                    Command="{Binding ClearHistoryCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                    <TextBlock Text="Очистити локальну історію" FontSize="11" FontWeight="Bold" Foreground="#25190E"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Height="38" Background="White" BorderBrush="#C4C0B8" BorderThickness="1" Cursor="Hand"
                                    Command="{Binding BackupDataCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                    <TextBlock Text="Резервне копіювання" FontSize="11" FontWeight="Bold" Foreground="#25190E"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- НИЖНІ КНОПКИ ДІЙ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Button Content="Скасувати" 
                            Command="{Binding CancelSettingsCommand}"
                            Height="40" Width="130" Margin="0,0,12,0"
                            Background="#FBF9F5" Foreground="#25190E" FontWeight="Bold" FontSize="12"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="Зберегти зміни" 
                            Command="{Binding SaveSettingsCommand}"
                            Height="40" Width="160"
                            Background="#25190E" Foreground="White" FontWeight="Bold" FontSize="12"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>