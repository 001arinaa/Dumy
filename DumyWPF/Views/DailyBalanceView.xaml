<UserControl x:Class="DumyWPF.Views.DailyBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F2ED">

    <UserControl.Resources>
        <!-- Кастомний стиль для рожевого слайдера (#DAB6C8) -->
        <Style TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="#EAE6DF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Name="TrackBackground" Height="6" CornerRadius="3" Background="#EAE6DF" VerticalAlignment="Center"/>
                            <Track Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3" Background="#DAB6C8"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#DAB6C8" Stroke="White" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="0">
        <!-- 1. ВЕРХНІЙ ХЕДЕР -->
        <Border DockPanel.Dock="Top" Background="White" Padding="30,12" BorderBrush="#EAE6DF" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DUMY" FontFamily="Georgia" FontSize="20" FontWeight="Bold" Foreground="#25190E"/>
                    <TextBlock Text=" v1.0" FontSize="18" FontFamily="Georgia" Foreground="#C4C0B8"/>
                    <Border Background="#DAB6C8" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MVP" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Режим роботи:" VerticalAlignment="Center" Foreground="#C4C0B8" FontSize="12" Margin="0,0,8,0"/>
                    <Border Background="#FBF9F5" CornerRadius="12" Padding="12,6" Margin="0,0,10,0" BorderBrush="#EAE6DF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="• Щоденний баланс" FontSize="12" FontWeight="SemiBold" Foreground="#25190E"/>
                            <TextBlock Text=" ∨" FontSize="10" Foreground="#C4C0B8" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FBF9F5" CornerRadius="15" Width="30" Height="30" BorderBrush="#EAE6DF" BorderThickness="1">
                        <TextBlock Text="⚙" FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#25190E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. НИЖНІЙ ФУТЕР -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,15" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="🧘 Переглянути бібліотеку практик" FontFamily="Segoe UI Emoji" FontSize="12" FontWeight="SemiBold" Foreground="#25190E" Cursor="Hand" Margin="0,0,20,0"/>
                <TextBlock Text="📊 Історія" FontFamily="Segoe UI Emoji" FontSize="12" FontWeight="SemiBold" Foreground="#25190E" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="Dumy v1.0 (MVP) піклується про вашу конфіденційність. Усі введені дані зберігаються локально." 
                       FontSize="10" Foreground="#C4C0B8" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 3. ОСНОВНИЙ КОНТЕНТ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="35,20">

                <!-- ДУМКА ДНЯ (ВИДІЛЕНО РОЖЕВИМ #F5E8EF ТА #DAB6C8) -->
                <Border Background="#F5E8EF" BorderBrush="#DAB6C8" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,0,20">
                    <Grid>
                        <StackPanel>
                            <Border Background="#DAB6C8" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="ДУМКА ДНЯ" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="«Твоя сила – у твоєму спокої. Кожен видих звільняє місце для нового балансу.»" 
                                       FontSize="15" FontWeight="Bold" Foreground="#25190E" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Dumy щоденне нагадування для збереження гармонії." FontSize="11" Foreground="#332418"/>
                        </StackPanel>
                        <TextBlock Text="💡" FontFamily="Segoe UI Emoji" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ЛІВА КОЛОНКА -->
                    <StackPanel Grid.Column="0">
                        <!-- ЯК ВИ ПОЧУВАЄТЕСЬ ЗАРАЗ -->
                        <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="♡ " FontFamily="Segoe UI Emoji" FontSize="14" Foreground="#DAB6C8" FontWeight="Bold"/>
                                    <TextBlock Text="ЯК ВИ ПОЧУВАЄТЕСЬ ЗАРАЗ?" FontWeight="Bold" FontSize="13" Foreground="#25190E"/>
                                </StackPanel>

                                <!-- КАРТКИ НАСТРОЮ -->
                                <UniformGrid Columns="4" Margin="0,0,0,18">
                                    <!-- Активна картка (Спокій) -->
                                    <Border Background="#F5E8EF" BorderBrush="#DAB6C8" BorderThickness="1.5" CornerRadius="12" Padding="8,12" Margin="3">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="😊" FontFamily="Segoe UI Emoji" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Спокій" FontSize="11" FontWeight="Bold" Foreground="#25190E" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Тривога -->
                                    <Border Background="#FBF9F5" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="12" Padding="8,12" Margin="3">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="😟" FontFamily="Segoe UI Emoji" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Тривога" FontSize="11" Foreground="#332418" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Втома -->
                                    <Border Background="#FBF9F5" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="12" Padding="8,12" Margin="3">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="😫" FontFamily="Segoe UI Emoji" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Втома" FontSize="11" Foreground="#332418" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Дратування -->
                                    <Border Background="#FBF9F5" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="12" Padding="8,12" Margin="3">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="😡" FontFamily="Segoe UI Emoji" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Дратування" FontSize="11" Foreground="#332418" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Рівень інтенсивності:" FontSize="11" Foreground="#C4C0B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Помірно (5 з 10)" FontSize="11" FontWeight="Bold" Foreground="#25190E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Slider Minimum="1" Maximum="10" Value="5" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Border>

                        <Button Content="ЗБЕРЕГТИ ТА ОТРИМАТИ РЕКОМЕНДАЦІЮ  ➔" 
                                Command="{Binding SaveMoodCommand}"
                                Height="44" Background="#DAB6C8" Foreground="#25190E" FontWeight="Bold" FontSize="12"
                                BorderThickness="0" Margin="0,0,0,15" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- ЩОДЕННИК ДУМОК -->
                        <Border Background="White" CornerRadius="16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ЩОДЕННИК ДУМОК" FontWeight="Bold" FontSize="13" Foreground="#25190E" Margin="0,0,0,12"/>
                                <Border BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="12" Padding="12" Background="#FBF9F5" Margin="0,0,0,10">
                                    <TextBox Height="90" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                             Background="Transparent" FontSize="12" Foreground="#332418" Text="Додати вільний запис думок або нотатку..."/>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                    <TextBlock Text="Збережено записів цього тижня: 5" FontSize="10" Foreground="#C4C0B8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ПРАВА КОЛОНКА -->
                    <StackPanel Grid.Column="2">
                        <!-- DUMY РЕКОМЕНДУЄ -->
                        <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Border Background="#FBF9F5" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="DUMY РЕКОМЕНДУЄ" FontSize="9" FontWeight="Bold" Foreground="#9AA3B6"/>
                                    </Border>
                                    <TextBlock Text="Сьогоднішній фокус" FontSize="10" Foreground="#C4C0B8" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="3-хвилинне дихання для балансу" FontWeight="Bold" FontSize="15" Foreground="#25190E" Margin="0,0,0,6"/>
                                <TextBlock Text="Проста, але потужна техніка для зниження тонусу нервової системи та фокусування думок на теперішньому моменті." 
                                           FontSize="11" Foreground="#332418" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <StackPanel Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="⏱ " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                        <TextBlock Text="Тривалість: 3 хв" FontSize="11" Foreground="#332418"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌿 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                        <TextBlock Text="Тип: Дихальна вправа" FontSize="11" Foreground="#332418"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Content="Розпочати  ➔" Width="110" Height="32" HorizontalAlignment="Right" 
                                        Background="#DAB6C8" Foreground="#25190E" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- ШВИДКІ ЗВИЧКИ -->
                        <Border Background="White" CornerRadius="16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ШВИДКІ ЗВИЧКИ" FontWeight="Bold" FontSize="13" Foreground="#25190E" Margin="0,0,0,12"/>

                                <!-- Звичка 1 -->
                                <Border Background="#FBF9F5" CornerRadius="12" Padding="12,10" Margin="0,0,0,8" BorderBrush="#EAE6DF" BorderThickness="1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💧" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Вода" FontWeight="Bold" FontSize="12" Foreground="#25190E"/>
                                                <TextBlock Text="1.2 л з 2.0 л" FontSize="10" Foreground="#C4C0B8"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Звичка 2 -->
                                <Border Background="#FBF9F5" CornerRadius="12" Padding="12,10" Margin="0,0,0,8" BorderBrush="#EAE6DF" BorderThickness="1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="😴" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Сон" FontWeight="Bold" FontSize="12" Foreground="#25190E"/>
                                                <TextBlock Text="7.5 год з 8.0 год" FontSize="10" Foreground="#C4C0B8"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Звичка 3 -->
                                <Border Background="#FBF9F5" CornerRadius="12" Padding="12,10" BorderBrush="#EAE6DF" BorderThickness="1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Фокус" FontWeight="Bold" FontSize="12" Foreground="#25190E"/>
                                                <TextBlock Text="2 сесії виконано" FontSize="10" Foreground="#C4C0B8"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox IsChecked="False" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>