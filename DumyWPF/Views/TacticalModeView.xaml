<UserControl x:Class="DumyWPF.Views.TacticalModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Background="#181615">

    <UserControl.Resources>
        <!-- Кастомний стиль для тактичного оливкового слайдера (#A3A075) -->
        <Style TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="#383431"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Name="TrackBackground" Height="6" CornerRadius="3" Background="#383431" VerticalAlignment="Center"/>
                            <Track Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3" Background="#A3A075"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#EAE6DF" Stroke="#A3A075" StrokeThickness="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="0">
        <!-- 1. ВЕРХНІЙ ХЕДЕР -->
        <Border DockPanel.Dock="Top" Background="#181615" Padding="30,12" BorderBrush="#2D2A28" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DUMY" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text=" v1.0" FontFamily="Georgia" FontSize="18" Foreground="#8E8A85"/>
                    <Border Background="#A3A075" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MVP" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#181615"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Режим роботи:" VerticalAlignment="Center" Foreground="#8E8A85" FontSize="12" Margin="0,0,8,0"/>
                    <Border Background="#2D2A28" CornerRadius="12" Padding="12,6" Margin="0,0,10,0" BorderBrush="#383431" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="• Тактичний" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock Text=" ∨" FontSize="10" Foreground="#8E8A85" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2D2A28" CornerRadius="15" Width="30" Height="30" BorderBrush="#383431" BorderThickness="1">
                        <TextBlock Text="⚙" FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. НИЖНІЙ ФУТЕР -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,15" HorizontalAlignment="Center">
            <TextBlock Text="📊 Історія заземлень та звітність" FontFamily="Segoe UI Emoji" FontSize="12" FontWeight="SemiBold" Foreground="#A3A075" Cursor="Hand" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Dumy v1.0 (MVP) піклується про вашу конфіденційність. Усі введені дані зберігаються локально на цьому пристрої." 
                       FontSize="10" Foreground="#6E6A65" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 3. ОСНОВНИЙ КОНТЕНТ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,25">

                <!-- КРИЗОВИЙ ПРОТОКОЛ -->
                <Border Background="#2D2A28" CornerRadius="14" Padding="24,18" Margin="0,0,0,15">
                    <Grid>
                        <StackPanel>
                            <Border Background="#44403B" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="КРИЗОВИЙ ПРОТОКОЛ" FontSize="9" FontWeight="Bold" Foreground="#A3A075"/>
                            </Border>
                            <TextBlock Text="ТАКТИЧНИЙ РЕЖИМ: ШВИДКА СТАБІЛІЗАЦІЯ" 
                                       FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                            <TextBlock Text="Екстрений доступ до заземлення, швидкої саморегуляції та зняття гострого когнітивного навантаження в стресових умовах." 
                                       FontSize="11" Foreground="#8E8A85" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="🛡" FontFamily="Segoe UI Emoji" FontSize="16" Foreground="#8E8A85" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- SOS КНОПКА (1-КЛІК) -->
                <Button Content="🚨 SOS ЗАЗЕМЛЕННЯ (1-КЛІК)" 
                        Command="{Binding SosClickCommand}"
                        Height="52" Background="#A3A075" Foreground="#181615" FontWeight="Bold" FontSize="15"
                        BorderThickness="0" Margin="0,0,0,8" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <TextBlock Text="Запускає експрес-протокол дихальної стабілізації негайно без зайвих кліків чи форм" 
                           FontSize="11" Foreground="#8E8A85" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <!-- МИТТЄВІ ТАКТИЧНІ ПРАКТИКИ -->
                <TextBlock Text="МИТТЄВІ ТАКТИЧНІ ПРАКТИКИ" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ПРАКТИКА 1 -->
                    <Border Grid.Column="0" Background="#2D2A28" CornerRadius="14" Padding="18,16">
                        <Grid>
                            <StackPanel Margin="0,0,45,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🫁 " FontFamily="Segoe UI Emoji" FontSize="13"/>
                                    <TextBlock Text="Тактичне дихання (4x4)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="4с вдох – 4с затримка – 4с видих – 4с затримка. Класична стабілізація частоти серцевих скорочень." 
                                           FontSize="10" Foreground="#8E8A85" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Width="36" Height="36" CornerRadius="18" Background="#A3A075" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                                <TextBlock Text="▷" FontSize="13" Foreground="#181615" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ПРАКТИКА 2 -->
                    <Border Grid.Column="2" Background="#2D2A28" CornerRadius="14" Padding="18,16">
                        <Grid>
                            <StackPanel Margin="0,0,45,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🧊 " FontFamily="Segoe UI Emoji" FontSize="13"/>
                                    <TextBlock Text="Метод заземлення 5–4–3–2–1" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="Швидке когнітивне перемикання уваги на об'єкти фізичного світу навколо вас." 
                                           FontSize="10" Foreground="#8E8A85" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Width="36" Height="36" CornerRadius="18" Background="#A3A075" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                                <TextBlock Text="▷" FontSize="13" Foreground="#181615" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ЕКСПРЕС-ФІКСАЦІЯ СТАНУ -->
                <Border Background="#2D2A28" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚡ " FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#A3A075"/>
                            <TextBlock Text="ЕКСПРЕС-ФІКСАЦІЯ СТАНУ" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Поточний рівень стресу" FontSize="11" Foreground="#8E8A85" VerticalAlignment="Center"/>
                            <TextBlock Text="Висока напруга (7 з 10)" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Slider Minimum="1" Maximum="10" Value="7" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="1 (Повний спокій)" FontSize="10" Foreground="#8E8A85" HorizontalAlignment="Left"/>
                            <TextBlock Text="10 (Максимальний стрес)" FontSize="10" Foreground="#8E8A85" HorizontalAlignment="Right"/>
                        </Grid>

                        <Button Content="ЗБЕРЕГТИ СТАН ТА СКОРИГУВАТИ ПРОТОКОЛ  ∨" 
                                Command="{Binding SaveTacticalStateCommand}"
                                Height="44" Background="#A3A075" Foreground="#181615" FontWeight="Bold" FontSize="12"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>