<UserControl x:Class="DumyWPF.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Background="#F5F2ED">

    <DockPanel Margin="0">
        <!-- 1. ВЕРХНІЙ ХЕДЕР -->
        <Border DockPanel.Dock="Top" Background="White" Padding="30,12" BorderBrush="#EAE6DF" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DUMY" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="#25190E"/>
                    <TextBlock Text=" v1.0" FontFamily="Georgia" FontSize="18" Foreground="#C4C0B8"/>
                    <Border Background="#DAB6C8" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MVP" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Режим роботи:" VerticalAlignment="Center" Foreground="#C4C0B8" FontSize="12" Margin="0,0,8,0"/>
                    <Border Background="#FBF9F5" CornerRadius="12" Padding="12,6" Margin="0,0,10,0" BorderBrush="#EAE6DF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="• Усі режими" FontSize="12" FontWeight="SemiBold" Foreground="#25190E"/>
                            <TextBlock Text=" ∨" FontSize="10" Foreground="#C4C0B8" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FBF9F5" CornerRadius="15" Width="30" Height="30" BorderBrush="#EAE6DF" BorderThickness="1">
                        <TextBlock Text="⚙" FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#25190E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. НИЖНІЙ ФУТЕР -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,15" HorizontalAlignment="Center">
            <TextBlock Text="Dumy v1.0 (MVP) піклується про вашу конфіденційність. Усі введені дані зберігаються локально." 
                       FontSize="10" Foreground="#C4C0B8" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 3. ОСНОВНИЙ КОНТЕНТ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="35,20">

                <!-- ЗАГОЛОВОК СТОРІНКИ -->
                <TextBlock Text="ІСТОРІЯ ТА АНАЛІТИКА" FontWeight="Bold" FontSize="20" Foreground="#25190E" Margin="0,0,0,2"/>
                <TextBlock Text="Відстежуйте свій прогрес та емоційний стан" FontSize="12" Foreground="#C4C0B8" Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ЛІВА КОЛОНКА (ГРАФІК СТАТИСТИКИ) -->
                    <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="⚙ " FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#25190E"/>
                                <TextBlock Text="ТРЕНД ВТОМИ ТА НАСТРОЮ" FontWeight="Bold" FontSize="13" Foreground="#25190E"/>
                            </StackPanel>

                            <!-- СТОВПЧАСТА ДІАГРАМА -->
                            <Grid Height="160" Margin="0,0,0,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="20"/>
                                </Grid.RowDefinitions>

                                <!-- Пунктирні сітки -->
                                <Border Grid.Row="0" BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="1" BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                                <!-- Стовпчики діаграми -->
                                <UniformGrid Grid.Row="0" Grid.RowSpan="3" Columns="7" VerticalAlignment="Bottom">
                                    <Border Width="18" Height="65" Background="#9AA3B6" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                    <Border Width="18" Height="95" Background="#9AA3B6" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                    <Border Width="18" Height="115" Background="#9AA3B6" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                    <Border Width="18" Height="65" Background="#9AA3B6" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                    <Border Width="18" Height="95" Background="#9AA3B6" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                    <Border Width="18" Height="45" Background="#9AA3B6" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                    <Border Width="18" Height="80" Background="#9AA3B6" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                </UniformGrid>

                                <!-- Підписи днів тижня -->
                                <UniformGrid Grid.Row="3" Columns="7" VerticalAlignment="Center">
                                    <TextBlock Text="Пн" FontSize="10" Foreground="#25190E" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Вт" FontSize="10" Foreground="#25190E" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ср" FontSize="10" Foreground="#25190E" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Чт" FontSize="10" Foreground="#25190E" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Пт" FontSize="10" Foreground="#25190E" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Сб" FontSize="10" Foreground="#25190E" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Нд" FontSize="10" Foreground="#25190E" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </UniformGrid>
                            </Grid>

                            <!-- ПЛАШКИ СТАТИСТИКИ -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                <Border Background="#F5E8EF" CornerRadius="10" Padding="10,6" Margin="0,0,6,0">
                                    <TextBlock Text="Середній рівень стресу: 4.2" FontSize="10" FontWeight="Bold" Foreground="#25190E"/>
                                </Border>
                                <Border Background="#9AA3B6" CornerRadius="10" Padding="10,6" Margin="0,0,6,0">
                                    <TextBlock Text="Всього сесій: 8" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border Background="#FBF9F5" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                    <TextBlock Text="Загальний час: 24 хв" FontSize="10" FontWeight="Bold" Foreground="#25190E"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="📊 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                    <TextBlock Text="Сесій цього тижня: 8" FontSize="11" FontWeight="Bold" Foreground="#25190E" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏱ " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                    <TextBlock Text="Загальний час практик: 24 хв" FontSize="11" FontWeight="Bold" Foreground="#25190E" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ПРАВА КОЛОНКА (ІДЕАЛЬНО ФІКСОВАНІ РЯДКИ) -->
                    <Border Grid.Column="2" Background="#FBF9F5" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <TextBlock Text="ОСТАННІ ЗАПИСИ ТА ПРАКТИКИ" FontSize="13" FontWeight="Bold" Foreground="#25190E" Margin="0,0,0,15"/>

                            <StackPanel>
                                <!-- Запис 1 -->
                                <Border BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#D9534F" Margin="0,0,8,0"/>
                                            <TextBlock Text="Сьогодні, 14:20" FontSize="10" Foreground="#C4C0B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="🚨 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                            <TextBlock Text="SOS Заземлення" FontSize="11" FontWeight="Bold" Foreground="#25190E"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Запис 2 -->
                                <Border BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#9AA3B6" Margin="0,0,8,0"/>
                                            <TextBlock Text="Сьогодні, 09:15" FontSize="10" Foreground="#C4C0B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="😊 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                            <TextBlock Text="Настрій: Спокій (7/10)" FontSize="11" FontWeight="Bold" Foreground="#25190E"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Запис 3 (ВИНРАВЛЕНИЙ РЯДОК З ДИХАННЯМ) -->
                                <Border BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#DAB6C8" Margin="0,0,8,0"/>
                                            <TextBlock Text="Вчора, 21:00" FontSize="10" Foreground="#C4C0B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="🫁 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                            <TextBlock Text="3-хв дихання" FontSize="11" FontWeight="Bold" Foreground="#25190E"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Запис 4 -->
                                <Border BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#9AA3B6" Margin="0,0,8,0"/>
                                            <TextBlock Text="Вчора, 09:00" FontSize="10" Foreground="#C4C0B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="😟 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                            <TextBlock Text="Настрій: Тривога (5/10)" FontSize="11" FontWeight="Bold" Foreground="#25190E"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Запис 5 -->
                                <Border BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#C4C0B8" Margin="0,0,8,0"/>
                                            <TextBlock Text="22 вересня" FontSize="10" Foreground="#C4C0B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="📝 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                            <TextBlock Text="Щоденник думок" FontSize="11" FontWeight="Bold" Foreground="#25190E"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Запис 6 -->
                                <Border BorderBrush="#EAE6DF" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#C4C0B8" Margin="0,0,8,0"/>
                                            <TextBlock Text="22 вересня" FontSize="10" Foreground="#C4C0B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="🧊 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                            <TextBlock Text="Метод 5–4–3–2–1" FontSize="11" FontWeight="Bold" Foreground="#25190E"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Запис 7 -->
                                <Border Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#C4C0B8" Margin="0,0,8,0"/>
                                            <TextBlock Text="21 вересня" FontSize="10" Foreground="#C4C0B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="😫 " FontFamily="Segoe UI Emoji" FontSize="11"/>
                                            <TextBlock Text="Настрій: Втома (6/10)" FontSize="11" FontWeight="Bold" Foreground="#25190E"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- КНОПКИ ЕКСПОРТУ ТА НОВІ ДІЇ -->
                <Grid Margin="0,10,0,0">
                    <Button Content="☕ Експортувати звіт (PDF/CSV)" 
                            Command="{Binding ExportReportCommand}"
                            Height="38" Width="210" HorizontalAlignment="Left"
                            Background="#FF25190E" Foreground="White" FontWeight="Bold" FontSize="11"
                            BorderThickness="0" Cursor="Hand" Click="Button_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Text="← Повернутися на головну" 
                               FontSize="11" FontWeight="Bold" Foreground="#25190E" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>