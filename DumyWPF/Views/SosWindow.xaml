<Window x:Class="DumyWPF.Views.SosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOS Заземлення" Width="460" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#181615" FontFamily="Segoe UI">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="SOS ЗАЗЕМЛЕННЯ" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Дихайте разом із колом. Ви в безпеці." FontSize="12" Foreground="#8E8A85"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Ellipse x:Name="Halo" Width="260" Height="260" Fill="#A3A075" Opacity="0.18"
                     HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale" ScaleX="0.5" ScaleY="0.5"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Circle" Width="200" Height="200" Fill="#A3A075"
                     HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="CircleScale" ScaleX="0.5" ScaleY="0.5"/></Ellipse.RenderTransform>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="PhaseText" Text="Приготуйтесь" FontSize="24" FontWeight="Bold" Foreground="#181615" HorizontalAlignment="Center"/>
                <TextBlock x:Name="CountText" Text="" FontSize="40" FontWeight="Bold" Foreground="#181615" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="CycleText" Grid.Row="2" Text="Цикл 0 з 6" FontSize="12" Foreground="#8E8A85"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <Button Grid.Row="3" Content="ЗАВЕРШИТИ" Height="44" Background="#A3A075" Foreground="#181615"
                FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="Close_Click">
            <Button.Resources>
                <Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
