<UserControl x:Class="DumyWPF.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F2ED">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="20" Padding="40,30" Width="550"
                BorderBrush="#EAE6DF" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center">

                <!-- Заголовок і плашка кроку -->
                <TextBlock Text="DUMY" FontFamily="Georgia" FontSize="30" FontWeight="Bold" 
                           Foreground="#25190E" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <Border Background="#F2EBE4" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#9AA3B6" Margin="0,0,6,0"/>
                        <TextBlock Text="Крок 1 з 2: Знайомство" FontSize="11" FontWeight="SemiBold" Foreground="#25190E"/>
                    </StackPanel>
                </Border>

                <!-- БЛОК ВВОДУ ІМЕНІ З ПЛЕЙСХОЛДЕРОМ ВСЕРЕДИНІ -->
                <TextBlock Text="Як до вас звертатися?" FontSize="12" FontWeight="Bold" 
                           Foreground="#25190E" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                <Border Background="#FBF9F5" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="12" Height="44" Padding="14,0" Margin="0,0,0,20">
                    <Grid VerticalAlignment="Center">
                        <!-- Плейсхолдер всередині блоку (видно тільки коли поле пусте) -->
                        <TextBlock Text="Введіть ваше ім'я..." 
                                   FontSize="13" 
                                   Foreground="#C4C0B8" 
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserName}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UserName}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Саме поле вводу -->
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" 
                                 BorderThickness="0" 
                                 Background="Transparent" 
                                 Foreground="#25190E"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Вибір режиму -->
                <TextBlock Text="Оберіть ваш основний режим роботи:" FontSize="12" FontWeight="Bold" 
                           Foreground="#25190E" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Картка 1: Щоденний баланс -->
                    <Border Grid.Column="0" Background="#FBF9F5" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="12" Padding="10">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectDailyCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="🤍" FontSize="14" HorizontalAlignment="Left"/>
                                <RadioButton IsChecked="{Binding IsDailyMode}" GroupName="Mode" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Щоденний баланс" FontSize="11" FontWeight="Bold" Foreground="#25190E" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Підтримка загальної гармонії та усвідомленості день за днем." FontSize="9" Foreground="#9AA3B6" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Картка 2: Відновлення та фокус -->
                    <Border Grid.Column="2" Background="#FBF9F5" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="12" Padding="10">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectFocusCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Left"/>
                                <RadioButton IsChecked="{Binding IsFocusMode}" GroupName="Mode" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Відновлення та фокус" FontSize="11" FontWeight="Bold" Foreground="#25190E" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Зниження стресу, покращення сну та продуктивності." FontSize="9" Foreground="#9AA3B6" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Картка 3: Тактичний -->
                    <Border Grid.Column="4" Background="#FBF9F5" BorderBrush="#EAE6DF" BorderThickness="1" CornerRadius="12" Padding="10">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectTacticalCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="🛡" FontSize="14" HorizontalAlignment="Left"/>
                                <RadioButton IsChecked="{Binding IsTacticalMode}" GroupName="Mode" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Тактичний" FontSize="11" FontWeight="Bold" Foreground="#25190E" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Швидка самодопомога у моменти тривоги чи гострого стресу." FontSize="9" Foreground="#9AA3B6" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Кнопка старту -->
                <Button Content="Розпочати роботу  ➔" 
                        Command="{Binding StartCommand}"
                        Height="42" Width="260" Background="#DAB6C8" Foreground="#25190E" 
                        FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Футер -->
                <TextBlock Text="Dumy v1.0 (MVP) піклується про вашу конфіденційність. Усі введені дані зберігаються локально." 
                           FontSize="9" Foreground="#C4C0B8" HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>