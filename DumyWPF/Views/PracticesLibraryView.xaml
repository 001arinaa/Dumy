<UserControl x:Class="DumyWPF.Views.PracticesLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Background="#F5F2ED">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" Padding="30,12" BorderBrush="#EAE6DF" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DUMY" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="#25190E"/>
                    <TextBlock Text=" v1.0" FontFamily="Georgia" FontSize="18" Foreground="#C4C0B8"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#FBF9F5" CornerRadius="15" Width="30" Height="30" BorderBrush="#EAE6DF" BorderThickness="1" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding NavigateSettingsCommand}"/>
                        </Border.InputBindings>
                        <TextBlock Text="⚙" FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#25190E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,15" HorizontalAlignment="Center">
            <TextBlock Text="Dumy v1.0 (MVP) піклується про вашу конфіденційність. Усі введені дані зберігаються локально."
                       FontSize="10" Foreground="#C4C0B8" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="35,20">
                <TextBlock Text="БІБЛІОТЕКА ПРАКТИК" FontWeight="Bold" FontSize="20" Foreground="#25190E" Margin="0,0,0,2"/>
                <TextBlock Text="Оберіть профіль і стан, щоб відфільтрувати практики." FontSize="12" Foreground="#C4C0B8" Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Профіль:" VerticalAlignment="Center" FontSize="12" Foreground="#25190E" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding ProfileFilters}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              Width="210" Height="28" Margin="0,0,24,0"/>
                    <TextBlock Text="Стан:" VerticalAlignment="Center" FontSize="12" Foreground="#25190E" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding StateFilters}" SelectedItem="{Binding SelectedState, Mode=TwoWay}"
                              Width="170" Height="28"/>
                </StackPanel>

                <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="#C4C0B8" Margin="0,0,0,12"/>
                <TextBlock Text="За цими фільтрами практик не знайдено." Visibility="{Binding EmptyVisibility}"
                           FontSize="12" Foreground="#25190E" Margin="0,0,0,12"/>

                <ItemsControl ItemsSource="{Binding Practices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="14" Padding="16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#25190E" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="#9AA3B6" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Instructions}" FontSize="11" Foreground="#332418" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding VideoNote}" FontSize="10" Foreground="#C4C0B8"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="#DAB6C8"
                                            VerticalAlignment="Center" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding PlayCommand}"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="{Binding PlayGlyph}" FontSize="14" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="← Повернутися на головну" FontSize="11" FontWeight="Bold" Foreground="#25190E"
                           Cursor="Hand" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <TextBlock.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding NavigateHomeCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
