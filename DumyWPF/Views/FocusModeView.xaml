<UserControl x:Class="DumyWPF.Views.FocusModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Background="#F5F2ED">

    <UserControl.Resources>
        <!-- Кастомний стиль для сіро-блакитного слайдера (#9AA3B6) -->
        <Style TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="#EAE6DF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Name="TrackBackground" Height="6" CornerRadius="3" Background="#EAE6DF" VerticalAlignment="Center"/>
                            <Track Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3" Background="#9AA3B6"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#9AA3B6" Stroke="White" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="0">
        <!-- 1. ВЕРХНІЙ ХЕДЕР -->
        <Border DockPanel.Dock="Top" Background="White" Padding="30,12" BorderBrush="#EAE6DF" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DUMY" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="#25190E"/>
                    <TextBlock Text=" v1.0" FontFamily="Georgia" FontSize="18" Foreground="#C4C0B8"/>
                    <Border Background="#9AA3B6" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MVP" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Режим роботи:" VerticalAlignment="Center" Foreground="#C4C0B8" FontSize="12" Margin="0,0,8,0"/>
                    <Border Background="#FBF9F5" CornerRadius="12" Padding="12,6" Margin="0,0,10,0" BorderBrush="#EAE6DF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="• Фокус та Вигорання" FontSize="12" FontWeight="SemiBold" Foreground="#25190E"/>
                            <TextBlock Text=" ∨" FontSize="10" Foreground="#C4C0B8" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FBF9F5" CornerRadius="15" Width="30" Height="30" BorderBrush="#EAE6DF" BorderThickness="1">
                        <TextBlock Text="⚙" FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#25190E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. НИЖНІЙ ФУТЕР -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,15" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="🧘 Переглянути бібліотеку практик" FontFamily="Segoe UI Emoji" FontSize="12" FontWeight="SemiBold" Foreground="#25190E" Cursor="Hand" Margin="0,0,20,0"/>
                <TextBlock Text="📊 Історія" FontFamily="Segoe UI Emoji" FontSize="12" FontWeight="SemiBold" Foreground="#25190E" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="Dumy v1.0 (MVP) піклується про вашу конфіденційність. Усі введені дані зберігаються локально." 
                       FontSize="10" Foreground="#C4C0B8" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 3. ОСНОВНИЙ КОНТЕНТ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="35,20">

                <!-- ДУМКА ДНЯ (ВИДІЛЕНО СІРО-БЛАКИТНИМ #EAEFF5 ТА #9AA3B6) -->
                <Border Background="#EAEFF5" BorderBrush="#9AA3B6" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,0,20">
                    <Grid>
                        <StackPanel>
                            <Border Background="#9AA3B6" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="ДУМКА ДНЯ" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="«Фокус – це не просто концентрація зусиль, це вміння вчасно давати собі простір для видиху.»" 
                                       FontSize="15" FontWeight="Bold" Foreground="#25190E" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Dumy щоденне нагадування для запобігання емоційному виснаженню." FontSize="11" Foreground="#332418"/>
                        </StackPanel>
                        <TextBlock Text="💡" FontFamily="Segoe UI Emoji" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ЛІВА КОЛОНКА -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ЗОНА КОГНІТИВНОГО РОЗВАНТАЖЕННЯ" FontWeight="Bold" FontSize="16" Foreground="#25190E" Margin="0,0,0,4"/>
                        <TextBlock Text="Швидке відновлення фокусу та зняття зорової напруги за допомогою науково обґрунтованих практик." 
                                   FontSize="11" Foreground="#C4C0B8" TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <!-- ВПРАВА 1 -->
                        <Border Background="White" CornerRadius="16" Padding="20,16" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="👀 " FontFamily="Segoe UI Emoji" FontSize="13"/>
                                        <TextBlock Text="2-хв вправа для очей" FontWeight="Bold" FontSize="13" Foreground="#25190E"/>
                                    </StackPanel>
                                    <TextBlock Text="Для зняття напруги від монітора" FontSize="11" Foreground="#C4C0B8"/>
                                </StackPanel>
                                <Border Width="34" Height="34" CornerRadius="17" Background="#9AA3B6" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                                    <TextBlock Text="▷" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ВПРАВА 2 -->
                        <Border Background="White" CornerRadius="16" Padding="20,16" Margin="0,0,0,20">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="🧠 " FontFamily="Segoe UI Emoji" FontSize="13"/>
                                        <TextBlock Text="3-хв зняття напруги" FontWeight="Bold" FontSize="13" Foreground="#25190E"/>
                                    </StackPanel>
                                    <TextBlock Text="Техніка «Пауза для розуму»" FontSize="11" Foreground="#C4C0B8"/>
                                </StackPanel>
                                <Border Width="34" Height="34" CornerRadius="17" Background="#9AA3B6" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                                    <TextBlock Text="▷" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- РІВЕНЬ ВИСНАЖЕННЯ -->
                        <Border Background="White" CornerRadius="16" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="⚙ " FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#25190E"/>
                                    <TextBlock Text="РІВЕНЬ ВИСНАЖЕННЯ" FontWeight="Bold" FontSize="13" Foreground="#25190E"/>
                                </StackPanel>
                                <TextBlock Text="Оцініть свій поточний стан від повного відновлення до максимальної розумової втоми." 
                                           FontSize="11" Foreground="#C4C0B8" TextWrapping="Wrap" Margin="0,0,0,20"/>

                                <Slider Minimum="1" Maximum="10" Value="6" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,20">
                                    <TextBlock Text="1 (Повний сил)" FontSize="10" FontWeight="Bold" Foreground="#25190E" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Помірна втома (6 з 10)" FontSize="10" FontWeight="Bold" Foreground="#25190E" HorizontalAlignment="Center"/>
                                    <TextBlock Text="10 (Виснажений)" FontSize="10" FontWeight="Bold" Foreground="#25190E" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- КНОПКА З БІЛИМ НАПИСОМ -->
                                <Button Content="ЗАФІКСУВАТИ ВТОМУ  ➔" 
                                        Command="{Binding LogFatigueCommand}"
                                        Height="44" Background="#9AA3B6" Foreground="White" FontWeight="Bold" FontSize="12"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="12"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ПРАВА КОЛОНКА -->
                    <StackPanel Grid.Column="2">
                        <!-- ШВИДКІ ЗВИЧКИ -->
                        <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="ШВИДКІ ЗВИЧКИ" FontWeight="Bold" FontSize="13" Foreground="#25190E" Margin="0,0,0,12"/>

                                <!-- Звичка 1 -->
                                <Border Background="#FBF9F5" CornerRadius="12" Padding="12,10" Margin="0,0,0,8" BorderBrush="#EAE6DF" BorderThickness="1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💧" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Вода" FontWeight="Bold" FontSize="12" Foreground="#25190E"/>
                                                <TextBlock Text="1.2 л з 2.0 л" FontSize="10" Foreground="#C4C0B8"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Звичка 2 -->
                                <Border Background="#FBF9F5" CornerRadius="12" Padding="12,10" Margin="0,0,0,8" BorderBrush="#EAE6DF" BorderThickness="1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="😴" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Сон" FontWeight="Bold" FontSize="12" Foreground="#25190E"/>
                                                <TextBlock Text="7.5 год з 8.0 год" FontSize="10" Foreground="#C4C0B8"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Звичка 3 -->
                                <Border Background="#FBF9F5" CornerRadius="12" Padding="12,10" BorderBrush="#EAE6DF" BorderThickness="1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Фокус" FontWeight="Bold" FontSize="12" Foreground="#25190E"/>
                                                <TextBlock Text="2 сесії виконано" FontSize="10" Foreground="#C4C0B8"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox IsChecked="False" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ОСТАННЯ АКТИВНІСТЬ -->
                        <Border Background="White" CornerRadius="16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ОСТАННЯ АКТИВНІСТЬ" FontWeight="Bold" FontSize="13" Foreground="#25190E" Margin="0,0,0,12"/>

                                <Border Background="#FBF9F5" CornerRadius="12" Padding="12,10" Margin="0,0,0,8" BorderBrush="#EAE6DF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="• " FontSize="12" Foreground="#C4C0B8"/>
                                        <TextBlock Text="3-хв дихання – завершено" FontSize="11" FontWeight="SemiBold" Foreground="#25190E"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FBF9F5" CornerRadius="12" Padding="12,10" BorderBrush="#EAE6DF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="• " FontSize="12" Foreground="#C4C0B8"/>
                                        <TextBlock Text="Рівень втоми: 6/10 – зафіксовано" FontSize="11" FontWeight="SemiBold" Foreground="#25190E"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>